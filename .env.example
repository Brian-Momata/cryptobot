# Copy to .env (never commit .env) and fill in. See docs/deploy.md.

# Binance spot TESTNET keys from https://testnet.binance.vision (they can't touch real money)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Telegram: token from @BotFather, chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dead-man's switch: a check URL from healthchecks.io (period 1 hour, grace 30 minutes)
HEALTHCHECK_URL=

# How much of the testnet account the bot manages
ALLOCATED_USDT=1000
SYMBOL=BTC/USDT
